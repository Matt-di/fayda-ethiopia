{
    "name": "mattdi/fayda-ethiopia",
    "description": "Fayda (eSignet) OpenID Connect client for PHP with a Laravel bridge: PKCE, private_key_jwt, JWKS verification, and verified Fayda identity data.",
    "keywords": [
        "fayda",
        "fayda-id",
        "ethiopia",
        "eid",
        "esignet",
        "mosip",
        "oidc",
        "openid",
        "sso",
        "laravel",
        "verifayda"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/Matt-di/fayda-ethiopia",
    "support": {
        "issues": "https://github.com/Matt-di/fayda-ethiopia/issues",
        "source": "https://github.com/Matt-di/fayda-ethiopia"
    },
    "authors": [
        {
            "name": "Mattdi"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.8",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.4",
        "pestphp/pest-plugin-laravel": "^3.2 || ^4.1",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "illuminate/support": "Required for the Laravel bridge (^12.0 || ^13.0).",
        "illuminate/http": "Required for the Laravel controller and routes (^12.0 || ^13.0).",
        "illuminate/routing": "Required for the Laravel routes (^12.0 || ^13.0).",
        "illuminate/auth": "Required for optional guard login (^12.0 || ^13.0)."
    },
    "autoload": {
        "psr-4": {
            "Mattdi\\Fayda\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mattdi\\Fayda\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mattdi\\Fayda\\Laravel\\FaydaServiceProvider"
            ],
            "aliases": {
                "Fayda": "Mattdi\\Fayda\\Laravel\\Facades\\Fayda"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
